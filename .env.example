# Local infrastructure
DATABASE_URL=postgres://upcraft:upcraft@127.0.0.1:15432/upcraft
VALKEY_URL=redis://127.0.0.1:16379
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=upcraft-local
S3_SECRET_ACCESS_KEY=upcraft-local-secret
S3_BUCKET=upcraft-private
S3_FORCE_PATH_STYLE=true

# Provider capability gates. A run blocks at preflight if required values are absent.
# Model routing is defined in packages/providers/src/model-config.ts. Each model
# key below overrides that registry entry. Write a bare model id to keep the
# default provider, or a "provider/model" reference (e.g.
# GEMINI_VERIFIER_MODEL=openai/gpt-5.6-terra) to reroute the stage.
AI_GATEWAY_API_KEY=
INTAKE_BRIEF_MODEL=openai/gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_VERIFIER_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional billing rate in microdollars per 1,000 input characters; leave empty to mark TTS cost unpriced.
ELEVENLABS_COST_MICRODOLLARS_PER_1K_CHARS=

# Source-less web research (s02) uses the official Brave Search MCP server over
# stdio. Version is pinned by BRAVE_MCP_ARGS; the ladder no longer has a model
# fallback, so auth/quota failures block visibly and exhaustion fails the run.
BRAVE_API_KEY=
# Optional billing rate in microdollars per Brave LLM Context query; empty marks the route unpriced.
BRAVE_COST_MICRODOLLARS_PER_QUERY=
RESEARCH_WEB_MODEL=llm-context/v1
# Override the sidecar launch. Docker worker example:
#   BRAVE_MCP_COMMAND=docker
#   BRAVE_MCP_ARGS="run -i --rm -e BRAVE_API_KEY mcp/brave-search:2.1.4"
BRAVE_MCP_COMMAND=npx
BRAVE_MCP_ARGS=-y @brave/brave-search-mcp-server@2.1.4 --transport stdio

# Runtime behavior
PIPELINE_BASE_URL=http://localhost:3100
RENDER_OUTPUT_DIR=./.local/renders
RUN_RETENTION_DAYS=30
